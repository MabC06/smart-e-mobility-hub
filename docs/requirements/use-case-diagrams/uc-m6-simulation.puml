@startuml uc-m6-simulation
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Operator" as op

rectangle "Smart E-Mobility Hub System" {
    usecase "UC-M6-01: Run What-if Simulation\nand Review Recommendations" as UC_M6_01
}

actor "M1: Core" as m1 << System >>
actor "M2: Reservation & Trip" as m2 << System >>
actor "M3: Charging & Smart Scheduling" as m3 << System >>
actor "M4: Allocation & Dispatching" as m4 << System >>
actor "M7: UI/UX" as m7 << System >>

op --> UC_M6_01

UC_M6_01 -- m1
UC_M6_01 -- m2
UC_M6_01 -- m3
UC_M6_01 -- m4
UC_M6_01 -- m7

note right of UC_M6_01
  Traces: FR-12, NFR-05, NFR-12, NFR-13
  Business Rules: BR-M6-03 (D-011)
  Scenarios: SC-01 to SC-05
end note

@enduml