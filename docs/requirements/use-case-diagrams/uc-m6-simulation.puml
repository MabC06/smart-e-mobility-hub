@startuml uc-m6-simulation
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
left to right direction

title Use Case Diagram — Module M6: What-if Simulation & Coordination\n(FR-12)

actor "Operator" as op <<Human>>
actor "M1 Core\n(operational snapshot)" as m1 <<System>>
actor "M2 Reservation\n(ReservationDemand port)" as m2 <<System>>
actor "M3 Charging\n(ChargingDemand port)" as m3 <<System>>
actor "M4 Allocation\n(dispatch proposals)" as m4 <<System>>

rectangle "Smart E-Mobility Hub — What-if Simulation (M6)" {
    usecase "UC-M6-01\nRun What-if Simulation\nand Review Recommendations" as UC_M6_01
    usecase "Submit Approved\nDispatch Proposal" as UC_Dispatch
}

op --> UC_M6_01
UC_M6_01 --> m1
UC_M6_01 --> m2
UC_M6_01 --> m3
UC_Dispatch .> UC_M6_01 : <<extend>>\n(Operator approves)
UC_Dispatch --> m4

note right of UC_M6_01
  Traces: FR-12, NFR-05, NFR-12, NFR-13
  Business Rules: BR-M6-03 (D-011)
  Scenarios: SC-01 to SC-05
  The Operator uses this through the M7 screens.
end note

@enduml
