@startuml
title A2 - Approve and execute a dispatch task (UC-M4-02 to UC-M4-04, FR-10.4 and FR-10.5)
skinparam shadowing false
skinparam defaultFontName Arial
start
:Operator selects a Recommended task;
if (Operator decision?) then (Reject)
  :Task Rejected; log;
  stop
else (Approve, optional lower quantity)
endif
:Read a fresh snapshot;
if (BR-M4-02..07 still valid?) then (no)
  :Task Failed (reason); offer to re-plan;
  stop
endif
:Begin one atomic unit of work;
:Hold vehicles (system reservation, purpose REBALANCE)\nand a destination space;
if (Hold succeeded without conflict?) then (no)
  :Roll back, nothing held; Task Failed (reason);
  stop
endif
:Commit; Task Approved;
if (Operator cancels before pick-up?) then (yes)
  :Release held vehicle and space; Task Cancelled;
  stop
endif
if (Pick-up confirmed before the timeout?) then (no)
  :Release held vehicle and space; Task Failed (timeout);
  :Start re-plan (UC-M4-08);
  stop
endif
:Task InProgress;
if (Operator cancels while in progress?) then (yes)
  if (Vehicle already at the destination?) then (yes)
    :Complete the task for that vehicle (no move back);
  else (no)
    :Release held vehicle and space; Task Cancelled;
  endif
  stop
endif
if (Return confirmed before the timeout, no fault?) then (yes)
  :Update vehicle location and both Hubs' space counts atomically;
  :Task Completed; log;
else (no)
  :Release held vehicle and space; Task Failed;
  :Start re-plan (UC-M4-08);
endif
stop
@enduml
