@startuml
title A2 - Approve and execute a dispatch task (UC-M4-02 to UC-M4-04, FR-10.4 and FR-10.5)
skinparam shadowing false
skinparam defaultFontName Arial
start
:Operator selects a Recommended task;
if (Operator decision?) then (Reject)
  :Task Rejected; log;
  stop
else (Approve, optional lower quantity)
endif
:Read a fresh snapshot;
if (BR-M4-02..06 and BR-M1-01 still valid?) then (no)
  :Task Failed (reason); offer to re-plan;
  stop
endif
:Begin one atomic unit of work;
:Place DISPATCH_TASK claims on vehicles\nand destination spaces via Core (D-017);
if (Claims succeeded without conflict?) then (no)
  :Roll back, nothing claimed; Task FAILED (reason);
  stop
endif
:Commit; Task APPROVED;
if (Operator cancels before pick-up?) then (yes)
  :Release DISPATCH_TASK vehicle & space claims; Task CANCELLED;
  stop
endif
if (Pick-up confirmed before the timeout?) then (no)
  :Release DISPATCH_TASK vehicle & space claims; Task FAILED (timeout);
  :Start re-plan (UC-M4-08);
  stop
endif
:Task IN_PROGRESS;
if (Operator cancels while in progress?) then (yes)
  if (Vehicle already at the destination?) then (yes)
    :Complete the task for that vehicle (no move back);
  else (no)
    :Release DISPATCH_TASK vehicle & space claims; Task CANCELLED;
  endif
  stop
endif
if (Return confirmed before the timeout, no fault?) then (yes)
  :Return vehicles using held space claims,\nrelease remaining DISPATCH_TASK claims,\nupdate locations and counts atomically;
  :Task COMPLETED; log;
else (no)
  :Release DISPATCH_TASK vehicle & space claims; Task FAILED;
  :Start re-plan (UC-M4-08);
endif
stop
@enduml
