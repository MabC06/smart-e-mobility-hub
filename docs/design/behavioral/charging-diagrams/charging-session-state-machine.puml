@startuml
left to right direction
skinparam state {
    BackgroundColor #E8F4F8
    BorderColor #2980B9
}

[*] --> REQUESTED : submit_charging_request

state REQUESTED as "REQUESTED"
state SCHEDULED as "SCHEDULED"
state CHARGING as "CHARGING"
state COMPLETED as "COMPLETED"
state INTERRUPTED as "INTERRUPTED"
state FAILED as "FAILED"

REQUESTED --> CHARGING : Bay available & start
REQUESTED --> SCHEDULED : Future schedule created
REQUESTED --> FAILED : Request validation error

SCHEDULED --> CHARGING : Scheduled time reached
SCHEDULED --> INTERRUPTED : Schedule cancelled

CHARGING --> COMPLETED : Target SoC reached
CHARGING --> INTERRUPTED : Session interrupted

COMPLETED --> [*]
INTERRUPTED --> [*]
FAILED --> [*]
@enduml