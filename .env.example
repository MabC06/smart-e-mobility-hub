# Copy to .env and fill in values locally:  cp .env.example .env
# NEVER commit .env. This file lists variable NAMES only (CONTRIBUTING 11.1).
# Variable set is provisional until the tech stack is accepted (see docs/DECISIONS.md D-002).

# --- Application ---
APP_ENV=            # development | test | production-demo
APP_HOST=           # interface to bind the API server to
APP_PORT=           # port of the API server
LOG_LEVEL=          # DEBUG | INFO | WARNING | ERROR
FRONTEND_ORIGIN=    # allowed origin for the web UI (CORS)

# --- Persistence ---
DATABASE_URL=       # connection string; keep credentials out of version control

# --- Security ---
SECRET_KEY=         # signing key for auth tokens; generate locally
ACCESS_TOKEN_TTL_MINUTES=   # lifetime of an auth token

# --- IoT simulator (src/iot_sim) ---
IOT_SIM_SEED=       # integer seed; same seed => same generated data (NFR-13)
IOT_SIM_EVENT_RATE=         # events per simulated minute
IOT_SIM_CLOCK_MODE=         # realtime | accelerated

# --- Operational thresholds (named config, no magic numbers) ---
HUB_NEAR_CAPACITY_RATIO=    # e.g. occupancy ratio that triggers a near-capacity alert
LOW_BATTERY_THRESHOLD_PCT=  # battery percentage treated as "low" by charging priority
RESERVATION_HOLD_MINUTES=   # hold time before an unclaimed reservation expires
