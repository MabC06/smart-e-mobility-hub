# Copy to .env and fill in values locally:  cp .env.example .env
# NEVER commit .env. This file lists variable NAMES only (CONTRIBUTING 11.1).
# Variable set is provisional until the tech stack is accepted (see docs/DECISIONS.md D-002).

# --- Application ---
APP_ENV=            # development | test | production-demo (production-demo hides /docs and /openapi.json)
APP_HOST=           # interface to bind the API server to
APP_PORT=           # port of the API server
LOG_LEVEL=          # DEBUG | INFO | WARNING | ERROR
FRONTEND_ORIGIN=    # only if the web UI is served from another origin (CORS); empty = none

# --- Persistence ---
DATABASE_URL=       # e.g. sqlite:///data/hub.db (the file and its folder are created); empty = in memory

# --- Security ---
SECRET_KEY=         # signing key for auth tokens, at least 16 characters, no default; generate locally
ACCESS_TOKEN_TTL_MINUTES=   # lifetime of an auth token (default 60)
PASSWORD_HASH_ITERATIONS=    # PBKDF2 cost of stored passwords (default 120000)

# --- IoT simulator (src/iot_sim) ---
IOT_SIM_SEED=       # integer seed; same seed => same generated data (NFR-13)
SEED_ON_START=      # true: load the demo network from iot_sim into an empty database at start (default false)
IOT_SIM_EVENT_RATE=         # events per simulated minute
IOT_SIM_CLOCK_MODE=         # realtime | accelerated

# --- Operational thresholds (named config, no magic numbers) ---
NEAR_CAPACITY_THRESHOLD=    # percent of parking occupied that marks a Hub as near full (default 90, BR-M5-01)
LOW_BATTERY_THRESHOLD=      # percent; at or below it a vehicle counts as low (default 15, BR-M3-03, BR-M5-05)
RESERVATION_HOLD_MINUTES=   # hold time before an unclaimed reservation expires
